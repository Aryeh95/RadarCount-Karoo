    <string name="settings_sensitivity_desc">Counts a car once it has come within %1$d m (%2$d ft) of you before dropping off the radar.</string>
    <string name="settings_sensitivity_strict_note">Fewest false counts; may miss cars that pass wide.</string>
    <string name="settings_sensitivity_normal_note">Recommended. Matches the rule mybiketraffic.com uses, so device and site agree.</string>
    <string name="settings_sensitivity_relaxed_note">Catches wide passes on open roads; may count a car that stops close behind you.</string>
