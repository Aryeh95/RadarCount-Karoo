<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the whole screen (RadarCountTheme). The window only
         shows these before the first frame and in the task switcher, and
         edge-to-edge clears the status bar once the activity starts. -->
    <style name="Theme.RadarCount" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#121212</item>
        <item name="android:statusBarColor">#1565C0</item>
        <item name="android:colorPrimary">#1976D2</item>
    </style>
</resources>
