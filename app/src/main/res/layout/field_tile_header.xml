<?xml version="1.0" encoding="utf-8"?>
<!-- The Radar field with its header (FieldBitmaps.combo): the RADAR strip
     at the top of whatever view the host gives, and the cells centred in
     the rest, as field_tile.xml centres them in the whole view. The strip
     bitmap is 20 dp tall (ComboLayout.HEADER_DP) and the cells bitmap the
     tile less that, so they fill the tile exactly when the host's view is
     the size it reported. The root's background carries the developer tint. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/field_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/field_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:adjustViewBounds="true"
        android:importantForAccessibility="no" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/field_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no" />

    </FrameLayout>

</LinearLayout>
