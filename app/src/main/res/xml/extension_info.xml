<?xml version="1.0" encoding="utf-8"?>
<ExtensionInfo
    id="mybiketraffic"
    displayName="@string/extension_name"
    icon="@drawable/ic_radar"
    configurable="true"
    fitFile="true">

    <DataType
        typeId="vehicle-count"
        description="@string/datatype_count_desc"
        displayName="@string/datatype_count"
        graphical="true"
        icon="@drawable/ic_car" />

    <DataType
        typeId="approach-speed"
        description="@string/datatype_speed_desc"
        displayName="@string/datatype_speed"
        graphical="true"
        icon="@drawable/ic_radar" />

    <DataType
        typeId="closest-distance"
        description="@string/datatype_distance_desc"
        displayName="@string/datatype_distance"
        graphical="true"
        icon="@drawable/ic_radar" />

</ExtensionInfo>
